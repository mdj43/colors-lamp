@startuml "activity"
start
:Enter Login Credentials;

if (Credentials Valid?) then (Yes)
    :Display Account Page;

    while (Logout?) is (No)

        switch (User Operation)

        case (Add Color)
            :Enter Color Name;
            :Add Color to Database;
            :Display Success Message;
        
        case (Search Color)
            :Enter Search Term;
            :Query Database on Search Term;
            :Display Matching Colors;
        
        endswitch

    endwhile (Yes)

else (No)
    :Display Login Error;

endif

stop
@enduml